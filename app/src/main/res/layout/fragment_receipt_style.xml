<?xml version="1.0" encoding="utf-8"?>
<!-- v2.9: Chek ko'rinishi — tepada jonli namuna, pastda sozlamalar (logo, shrift, nimalar chiqsin, printer) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/receipt_style_menu"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/rs_title" />

    <ScrollView
        android:id="@+id/previewScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFD9D9D9"
        android:fillViewport="true">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/rs_preview"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:scaleType="fitStart" />
    </ScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/rs_sec_preset"
            android:textAppearance="@style/TextAppearance.App.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetStd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_preset_std"
                    android:maxLines="2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreset1c"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_preset_1c"
                    android:maxLines="2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetCompact"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_preset_compact"
                    android:maxLines="2" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rs_preset_hint"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/rs_sec_texts"
            android:textAppearance="@style/TextAppearance.App.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHeader"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/share_receipt_header"
                app:helperText="@string/share_receipt_header_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSub"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/rs_sub"
                app:helperText="@string/rs_sub_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStaff"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/rc_staff_field"
                app:helperText="@string/rc_staff_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtStaff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFooter"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/rc_footer_field"
                app:helperText="@string/rc_footer_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilThanks"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/rs_thanks"
                app:helperText="@string/rs_thanks_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtThanks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/rs_sec_logo"
            android:textAppearance="@style/TextAppearance.App.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_line_match"
                    android:contentDescription="@string/rs_logo"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogoPick"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/rs_logo_pick"
                    android:maxLines="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogoRemove"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rs_logo_remove"
                    android:maxLines="2" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_logo_show" />
            <TextView
                android:id="@+id/tvLogoWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sLogoWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="20"
                android:valueTo="100"
                app:labelBehavior="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/rs_sec_font"
            android:textAppearance="@style/TextAppearance.App.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaper80"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_paper_80"
                    android:maxLines="2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaper58"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_paper_58"
                    android:maxLines="2" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFontSystem"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_font_system"
                    android:maxLines="2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFontArial"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rs_font_arial"
                    android:maxLines="2" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_bold" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swHeaderSerif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_header_serif" />
            <TextView
                android:id="@+id/tvText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="70"
                android:valueTo="150"
                app:labelBehavior="gone" />
            <TextView
                android:id="@+id/tvHeaderSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="10"
                android:valueFrom="50"
                android:valueTo="180"
                app:labelBehavior="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/rs_sec_show"
            android:textAppearance="@style/TextAppearance.App.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_staff" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_number" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_time" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_date" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_client" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_before" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLineNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_lineno" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_frame" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_after" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_footer" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rs_show_notes" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/rs_sec_printer"
            android:textAppearance="@style/TextAppearance.App.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">
            <TextView
                android:id="@+id/tvDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="10"
                android:valueFrom="100"
                android:valueTo="220"
                app:labelBehavior="gone" />
            <TextView
                android:id="@+id/tvFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:valueFrom="0"
                android:valueTo="40"
                app:labelBehavior="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestPrint"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/rs_test_print"
                    app:icon="@drawable/ic_print"
                    android:maxLines="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareSample"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/rs_share_sample"
                    android:maxLines="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvPrintHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rs_print_hint"
                android:textAppearance="@style/TextAppearance.App.ItemSub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
